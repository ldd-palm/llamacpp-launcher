<!-- src/LlamaCppLauncher/About/AboutWindow.xaml -->
<ui:FluentWindow
  x:Class="LlamaCppLauncher.About.AboutWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:conv="clr-namespace:LlamaCppLauncher.Converters"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Status — llama.cpp Launcher"
  Width="420"
  Height="440"
  ExtendsContentIntoTitleBar="True"
  ResizeMode="NoResize"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterScreen"
  >
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />

    <!-- Looks like a plain label but is a real (read-only) TextBox, so the value can be selected and
         copied — used for File name / Alias / API URL, which the user asked to be copyable but not
         clickable. -->
    <Style x:Key="CopyableValueStyle" TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Cursor" Value="IBeam" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="Status" FontSize="16" FontWeight="SemiBold">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/Assets/cpp_logo_color.ico" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsServiceRunning, Converter={StaticResource BoolToVis}}">
      <StackPanel Margin="0,12,8,0">
        <TextBlock FontWeight="SemiBold" Text="File name" />
        <TextBox Style="{StaticResource CopyableValueStyle}" Text="{Binding FileName, Mode=OneWay}" />

        <TextBlock FontWeight="SemiBold" Text="Alias" />
        <TextBox Style="{StaticResource CopyableValueStyle}" Text="{Binding Alias, Mode=OneWay}" />

        <TextBlock FontWeight="SemiBold" Text="Web Chat URL" />
        <TextBlock Margin="0,0,0,8">
          <Hyperlink Click="OnWebChatUrlClick">
            <Run Text="{Binding WebChatUrl, Mode=OneWay}" />
          </Hyperlink>
        </TextBlock>

        <TextBlock FontWeight="SemiBold" Text="API URL" />
        <TextBox Style="{StaticResource CopyableValueStyle}" Text="{Binding ApiUrl, Mode=OneWay}" />

        <TextBlock FontWeight="SemiBold" Text="Quantization" />
        <TextBlock Margin="0,0,0,8" Text="{Binding Quantization}" />

        <TextBlock FontWeight="SemiBold" Text="Total Params" />
        <TextBlock Margin="0,0,0,8" Text="{Binding TotalParams}" />

        <TextBlock FontWeight="SemiBold" Text="Context Size" />
        <TextBlock Margin="0,0,0,8" Text="{Binding ContextSize}" />
      </StackPanel>
    </ScrollViewer>

    <TextBlock Grid.Row="1" Margin="0,12,0,0" Text="No model is currently running." Visibility="{Binding IsServiceRunning, Converter={StaticResource InverseBoolToVis}}" />

    <Button Grid.Row="2" Margin="0,16,0,0" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="OnProjectHomepageClick">
      <StackPanel Orientation="Horizontal">
        <Image Width="24" Height="24" Source="pack://application:,,,/Assets/llamacpp.png" />
        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="llama.cpp on GitHub" TextDecorations="Underline" />
      </StackPanel>
    </Button>
  </Grid>
</ui:FluentWindow>
