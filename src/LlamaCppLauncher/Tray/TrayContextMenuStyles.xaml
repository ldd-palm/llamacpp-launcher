<!-- src/LlamaCppLauncher/Tray/TrayContextMenuStyles.xaml -->
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  >
  <SolidColorBrush x:Key="TrayMenu.PickerBgFill" Color="#FFFFFF" />
  <SolidColorBrush x:Key="TrayMenu.SurfaceStroke" Color="#E1E1E1" />
  <SolidColorBrush x:Key="TrayMenu.CmbHighlight" Color="#DBEAFE" />
  <SolidColorBrush x:Key="TrayMenu.TextPrimary" Color="#111111" />
  <SolidColorBrush x:Key="TrayMenu.TextTertiary" Color="#9CA3AF" />

  <!-- Flat, no-icon-gutter, full-bleed-text pill item. Same template handles leaf items and the
       "Switch" submenu header (the arrow glyph and its right-flyout Popup only show up for headers,
       driven by Role via the trigger below) so top-level items and submenu entries look identical. -->
  <ControlTemplate x:Key="TrayMenu.MenuItemTemplate" TargetType="MenuItem">
    <Border x:Name="Bd" CornerRadius="5" Margin="2,1" MinWidth="160" Background="Transparent">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ContentPresenter
          x:Name="HeaderHost"
          Grid.Column="0"
          Margin="12,6"
          VerticalAlignment="Center"
          ContentSource="Header"
          RecognizesAccessKey="True"
          TextElement.FontSize="13"
          TextElement.Foreground="{StaticResource TrayMenu.TextPrimary}"
          />
        <Path
          x:Name="Arrow"
          Grid.Column="1"
          Margin="0,0,10,0"
          VerticalAlignment="Center"
          Data="M0,0 L4,4 L0,8"
          Stroke="{StaticResource TrayMenu.TextPrimary}"
          StrokeThickness="1.3"
          Visibility="Collapsed"
          />
        <Popup
          x:Name="PART_Popup"
          AllowsTransparency="True"
          Focusable="False"
          HorizontalOffset="4"
          IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
          Placement="Right"
          PopupAnimation="Fade"
          VerticalOffset="-5"
          >
          <Border
            Padding="4"
            Background="{StaticResource TrayMenu.PickerBgFill}"
            BorderBrush="{StaticResource TrayMenu.SurfaceStroke}"
            BorderThickness="1"
            CornerRadius="8"
            >
            <Border.Effect>
              <DropShadowEffect BlurRadius="16" Color="Black" Direction="270" Opacity="0.12" ShadowDepth="2" />
            </Border.Effect>
            <StackPanel IsItemsHost="True" />
          </Border>
        </Popup>
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="Role" Value="SubmenuHeader">
        <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{StaticResource TrayMenu.CmbHighlight}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="HeaderHost" Property="TextElement.Foreground" Value="{StaticResource TrayMenu.TextTertiary}" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsEnabled" Value="False" />
          <Condition Property="IsHighlighted" Value="True" />
        </MultiTrigger.Conditions>
        <Setter TargetName="Bd" Property="Background" Value="Transparent" />
      </MultiTrigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="TrayMenu.MenuItemStyle" TargetType="MenuItem">
    <Setter Property="Template" Value="{StaticResource TrayMenu.MenuItemTemplate}" />
  </Style>

  <Style x:Key="TrayMenu.SeparatorStyle" TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Margin="6,4" Background="{StaticResource TrayMenu.SurfaceStroke}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The outer container: white surface, 1px border, 8px corner radius, soft drop shadow standing in
       for a Fluent acrylic/mica flyout (a real blur-behind isn't available for a plain WPF Popup).
       Deliberately no ItemContainerStyle here — ContextMenu.Items mixes MenuItem and Separator, and a
       flat ItemContainerStyle typed to MenuItem throws when WPF tries to apply it to a Separator.
       Each item gets its Style assigned explicitly in TrayController instead. -->
  <Style x:Key="TrayMenu.ContextMenuStyle" TargetType="ContextMenu">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border
            Padding="4"
            Background="{StaticResource TrayMenu.PickerBgFill}"
            BorderBrush="{StaticResource TrayMenu.SurfaceStroke}"
            BorderThickness="1"
            CornerRadius="8"
            >
            <Border.Effect>
              <DropShadowEffect BlurRadius="16" Color="Black" Direction="270" Opacity="0.12" ShadowDepth="2" />
            </Border.Effect>
            <StackPanel IsItemsHost="True" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
